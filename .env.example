# Local development settings. Copy to .env (git-ignored) only if you need to override.
# These values match the docker-compose.yml dev container; they are not secrets.
#
# Either set a full DSN:
#   DATABASE_URL=postgres://<user>:<password>@localhost:5450/horizon?sslmode=disable
# or the parts below (backend/internal/config builds the DSN from them):
PGUSER=horizon
PGPASSWORD=horizon
PGHOST=localhost
PGPORT=5450
PGDATABASE=horizon

NATS_URL=nats://localhost:4230
OLLAMA_URL=http://localhost:11434

# Browser origins allowed by the API (CORS), comma separated. The dashboard is
# a separate repo (https://github.com/Joao-Pedro-AI-Visionary/horizon-web);
# the default covers its Vite dev (:5173) and preview (:4173) servers.
HORIZON_CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173
