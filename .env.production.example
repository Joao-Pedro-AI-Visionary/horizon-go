# Production settings (Render free web service + Neon + Groq + Cloudflare
# Workers AI). Copy the values into the Render dashboard; NEVER commit a filled
# copy. Step by step: docs/deploy.md.

# --- secrets ---
# Neon: the DIRECT endpoint (host without "-pooler"), sslmode=require.
# "&channel_binding=require" from the Neon console is accepted (it is dropped).
DATABASE_URL=postgresql://<user>:<password>@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require
GROQ_API_KEY=gsk_...
CF_ACCOUNT_ID=<cloudflare account id>
CF_API_TOKEN=<token with Workers AI: Read/Edit>
# The Vercel domain(s) of horizon-web, comma separated, no trailing slash.
HORIZON_CORS_ORIGINS=https://horizon-web.vercel.app
# Bearer token for every write route (generate: openssl rand -hex 32).
# Unset in production = writes refused with 503.
HORIZON_ADMIN_TOKEN=
HORIZON_ENV=production

# --- models ---
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
LLM_RPM=20
# cloudflare | none (none = no embeddings: items are scored, never merged)
EMBED_PROVIDER=cloudflare
EMBED_MODEL=@cf/baai/bge-base-en-v1.5

# --- runtime (defaults baked into the image are fine) ---
SCORE_WORKERS=1
COLLECT_INTERVAL=off
COLLECT_COOLDOWN=10m
COLLECT_WINDOW=16h
SOURCE_TIMEOUT=30s
WORKER_SEED=true
TZ=America/Sao_Paulo
# Render sets PORT; the API listens on it (API_ADDR overrides).
# NATS_URL unset = embedded nats-server (JetStream in /tmp, ephemeral).
